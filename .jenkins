pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/md-arshaq/NovaChat.git'
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying NovaChat...'
                // Add your deploy command here later
            }
        }
    }

    post {
        success { echo 'Pipeline passed!' }
        failure  { echo 'Pipeline failed. Check the logs.' }
    }
}